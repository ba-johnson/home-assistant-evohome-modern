@@ -0,0 +1,60 @@
+"""Regression coverage for controller reset leaving DHW overridden."""
+
+from collections.abc import Awaitable
+from unittest.mock import AsyncMock, MagicMock
+
+import evohomeasync2 as evo
+import pytest
+
+from homeassistant.components.evohome.button import EvoSystemResetButton
+from homeassistant.components.evohome.coordinator import EvoDataUpdateCoordinator
+from homeassistant.core import HomeAssistant
+
+
+@pytest.mark.parametrize("has_hot_water", [True, False])
+async def test_system_reset_clears_hot_water(
+    hass: HomeAssistant, has_hot_water: bool
+) -> None:
+    """Clear DHW separately because controller AutoWithReset does not do so."""
+    coordinator = MagicMock(spec=EvoDataUpdateCoordinator)
+    coordinator.hass = hass
+
+    async def call_api(
+        coro: Awaitable[object], *, request_refresh: bool = True
+    ) -> object:
+        return await coro
+
+    coordinator.call_client_api = AsyncMock(side_effect=call_api)
+    coordinator.async_request_refresh = AsyncMock()
+    controller = MagicMock(spec=evo.ControlSystem)
+    controller.id = "test-controller"
+    controller.reset = AsyncMock()
+    hot_water = MagicMock(spec=evo.HotWater)
+    hot_water.reset = AsyncMock()
+    controller.hotwater = hot_water if has_hot_water else None
+    await EvoSystemResetButton(coordinator, controller).async_press()
+    controller.reset.assert_awaited_once()
+    assert hot_water.reset.await_count == int(has_hot_water)
+    coordinator.async_request_refresh.assert_awaited_once()
+
+
+async def test_failed_reset_still_refreshes(hass: HomeAssistant) -> None:
+    """Report a failing reset and refresh the state after partial completion."""
+    coordinator = MagicMock(spec=EvoDataUpdateCoordinator)
+    coordinator.hass = hass
+
+    async def call_api(
+        coro: Awaitable[object], *, request_refresh: bool = True
+    ) -> object:
+        return await coro
+
+    coordinator.call_client_api = AsyncMock(side_effect=call_api)
+    coordinator.async_request_refresh = AsyncMock()
+    controller = MagicMock(spec=evo.ControlSystem)
+    controller.id = "test-controller"
+    controller.reset = AsyncMock()
+    controller.hotwater = MagicMock(spec=evo.HotWater)
+    controller.hotwater.reset = AsyncMock(side_effect=RuntimeError("reset failed"))
+    with pytest.raises(RuntimeError, match="reset failed"):
+        await EvoSystemResetButton(coordinator, controller).async_press()
+    coordinator.async_request_refresh.assert_awaited_once()

+@pytest.mark.parametrize("install", ["default"])
+async def test_reload_and_options_keep_all_ids(
+    hass: HomeAssistant,
+    config: dict[str, str],
+    install: str,
+    entity_registry: er.EntityRegistry,
+) -> None:
+    """Reload platforms and apply a polling option without renaming entities."""
+    async for _ in setup_evohome(hass, config, install=install):
+        entry = hass.config_entries.async_entries(DOMAIN)[0]
+        before = {
+            row.unique_id: row.entity_id
+            for row in entity_registry.entities.values()
+            if row.platform == DOMAIN and row.config_entry_id == entry.entry_id
+        }
+        await hass.config_entries.async_reload(entry.entry_id)
+        await hass.async_block_till_done()
+        assert entry.state == ConfigEntryState.LOADED
+        form = await hass.config_entries.options.async_init(entry.entry_id)
+        assert form["step_id"] == "init"
+        result = await hass.config_entries.options.async_configure(
+            form["flow_id"], {"scan_interval": 600}
+        )
+        await hass.async_block_till_done()
+        assert result["type"] == "create_entry"
+        assert entry.options["scan_interval"] == 600
+        assert get_evo_data(hass).coordinator.update_interval.total_seconds() == 600
+        after = {
+            row.unique_id: row.entity_id
+            for row in entity_registry.entities.values()
+            if row.platform == DOMAIN and row.config_entry_id == entry.entry_id
+        }
+        assert before == after
+

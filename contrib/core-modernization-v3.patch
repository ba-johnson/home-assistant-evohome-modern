diff --git a/tests/components/evohome/test_config_flow.py b/tests/components/evohome/test_config_flow.py
new file mode 100644
index 0000000000..43a39c87d0
--- /dev/null
+++ b/tests/components/evohome/test_config_flow.py
@@ -0,0 +1,275 @@
+"""Core-fixture tests for the proposed Evohome config-entry migration."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from aiohttp import ClientError
+import evohomeasync2 as evo
+import pytest
+from pytest_homeassistant.common import MockConfigEntry
+
+from homeassistant import requirements
+from homeassistant.components.evohome.config_flow import (
+    EvohomeConfigFlow,
+    EvohomeOptionsFlow,
+)
+from homeassistant.config_entries import ConfigFlowResult
+from homeassistant.core import HomeAssistant
+
+CREDENTIALS = {"username": "test@example.invalid", "password": "test-only"}
+
+
+@pytest.fixture
+def flow(hass: HomeAssistant) -> EvohomeConfigFlow:
+    """Provide an unattached flow for isolated error-path tests."""
+    result = EvohomeConfigFlow()
+    result.hass = hass
+    result.context = {"source": "user"}
+    result.flow_id = "test"
+    return result
+
+
+@pytest.fixture
+def systems() -> list[tuple[int, SimpleNamespace, SimpleNamespace]]:
+    """Provide a fake controller with stable identifiers."""
+    controller = SimpleNamespace(id="controller-test")
+    location = SimpleNamespace(
+        id="location-test",
+        name="Test home",
+        gateways=[SimpleNamespace(systems=[controller])],
+    )
+    return [(0, location, controller)]
+
+
+@pytest.fixture
+def entry() -> MockConfigEntry:
+    """Provide the selected controller identity."""
+    return MockConfigEntry(
+        domain="evohome",
+        unique_id="location-test_controller-test",
+        data={
+            **CREDENTIALS,
+            "location_id": "location-test",
+            "system_id": "controller-test",
+        },
+        options={"scan_interval": 300},
+    )
+
+
+async def test_user_flow_manager(
+    hass: HomeAssistant, systems: list[tuple[int, SimpleNamespace, SimpleNamespace]]
+) -> None:
+    """Create a native config entry through Core's flow manager."""
+    await requirements.async_get_integration_with_requirements(hass, "evohome")
+    with (
+        patch.object(
+            EvohomeConfigFlow, "_async_discover", AsyncMock(return_value=systems)
+        ),
+        patch(
+            "homeassistant.components.evohome.async_setup_entry",
+            AsyncMock(return_value=None),
+        ),
+    ):
+        result = await hass.config_entries.flow.async_init(
+            "evohome", context={"source": "user"}
+        )
+        assert result["step_id"] == "user"
+        result = await hass.config_entries.flow.async_configure(
+            result["flow_id"], CREDENTIALS
+        )
+        assert result["step_id"] == "controller"
+        result = await hass.config_entries.flow.async_configure(
+            result["flow_id"], {"system_id": "controller-test"}
+        )
+        await hass.async_block_till_done()
+    assert result["type"] == "create_entry"
+    assert result["result"].unique_id == "location-test_controller-test"
+
+
+@pytest.mark.parametrize(
+    ("error", "reason"),
+    [
+        pytest.param(evo.BadUserCredentialsError("invalid"), "invalid_auth", id="auth"),
+        pytest.param(TimeoutError(), "cannot_connect", id="timeout"),
+        pytest.param(ClientError("offline"), "cannot_connect", id="client"),
+        pytest.param(evo.EvohomeError("offline"), "cannot_connect", id="vendor"),
+    ],
+)
+async def test_user_errors(
+    flow: EvohomeConfigFlow, error: Exception, reason: str
+) -> None:
+    """Keep failures retryable without storing credentials."""
+    with patch.object(flow, "_async_discover", AsyncMock(side_effect=error)):
+        result = await flow.async_step_user(CREDENTIALS)
+    assert result["errors"] == {"base": reason}
+
+
+async def test_no_systems(flow: EvohomeConfigFlow) -> None:
+    """Reject accounts with no supported controller."""
+    with patch.object(flow, "_async_discover", AsyncMock(return_value=[])):
+        assert (await flow.async_step_user(CREDENTIALS))["reason"] == "no_systems"
+
+
+async def test_single_instance(flow: EvohomeConfigFlow, entry: MockConfigEntry) -> None:
+    """Reject duplicate setup before account discovery."""
+    with patch.object(flow, "_async_current_entries", return_value=[entry]):
+        assert (await flow.async_step_user())["reason"] == "single_instance_allowed"
+
+
+async def test_controller_checks(
+    flow: EvohomeConfigFlow,
+    systems: list[tuple[int, SimpleNamespace, SimpleNamespace]],
+    entry: MockConfigEntry,
+) -> None:
+    """Reject an invalid choice and a concurrent second controller."""
+    flow._systems = systems
+    flow._credentials = CREDENTIALS
+    assert (await flow.async_step_controller({"system_id": "missing"}))[
+        "reason"
+    ] == "no_systems"
+    with patch.object(flow, "_async_current_entries", return_value=[entry]):
+        assert (await flow.async_step_controller({"system_id": "controller-test"}))[
+            "reason"
+        ] == "single_instance_allowed"
+
+
+@pytest.mark.parametrize(
+    ("error", "reason"),
+    [
+        pytest.param(evo.BadUserCredentialsError("invalid"), "invalid_auth", id="auth"),
+        pytest.param(TimeoutError(), "cannot_connect", id="timeout"),
+    ],
+)
+async def test_import_errors(
+    flow: EvohomeConfigFlow, error: Exception, reason: str
+) -> None:
+    """Abort invalid YAML imports."""
+    with patch.object(flow, "_async_discover", AsyncMock(side_effect=error)):
+        assert (await flow.async_step_import(CREDENTIALS))["reason"] == reason
+
+
+async def test_import(
+    flow: EvohomeConfigFlow, systems: list[tuple[int, SimpleNamespace, SimpleNamespace]]
+) -> None:
+    """Import stable IDs and clamp legacy polling."""
+    with patch.object(flow, "_async_discover", AsyncMock(return_value=systems)):
+        result = await flow.async_step_import({**CREDENTIALS, "scan_interval": 60})
+    assert result["type"] == "create_entry"
+    assert result["options"] == {"scan_interval": 180}
+
+
+async def test_import_missing_location(
+    flow: EvohomeConfigFlow, systems: list[tuple[int, SimpleNamespace, SimpleNamespace]]
+) -> None:
+    """Do not silently switch legacy location index."""
+    with patch.object(flow, "_async_discover", AsyncMock(return_value=systems)):
+        assert (await flow.async_step_import({**CREDENTIALS, "location_idx": 9}))[
+            "reason"
+        ] == "no_systems"
+
+
+@pytest.mark.parametrize(
+    "entries",
+    [
+        pytest.param([True], id="already-configured"),
+        pytest.param([False, True], id="concurrent"),
+    ],
+)
+async def test_import_single_instance(
+    flow: EvohomeConfigFlow,
+    systems: list[tuple[int, SimpleNamespace, SimpleNamespace]],
+    entries: list[bool],
+    entry: MockConfigEntry,
+) -> None:
+    """Avoid duplicate entries during import races."""
+    with (
+        patch.object(
+            flow,
+            "_async_current_entries",
+            side_effect=[[entry] * int(value) for value in entries],
+        ),
+        patch.object(flow, "_async_discover", AsyncMock(return_value=systems)),
+    ):
+        assert (await flow.async_step_import(CREDENTIALS))[
+            "reason"
+        ] == "single_instance_allowed"
+
+
+@pytest.mark.parametrize(
+    ("error", "reason"),
+    [
+        pytest.param(evo.BadUserCredentialsError("invalid"), "invalid_auth", id="auth"),
+        pytest.param(TimeoutError(), "cannot_connect", id="timeout"),
+    ],
+)
+async def test_reauth_errors(
+    flow: EvohomeConfigFlow, entry: MockConfigEntry, error: Exception, reason: str
+) -> None:
+    """Keep credentials unchanged after failed reauthentication."""
+    with (
+        patch.object(flow, "_get_reauth_entry", return_value=entry),
+        patch.object(flow, "_async_discover", AsyncMock(side_effect=error)),
+    ):
+        assert (await flow.async_step_reauth_confirm(CREDENTIALS))["errors"] == {
+            "base": reason
+        }
+
+
+async def test_reauth_forms_and_identity(
+    flow: EvohomeConfigFlow,
+    entry: MockConfigEntry,
+    systems: list[tuple[int, SimpleNamespace, SimpleNamespace]],
+) -> None:
+    """Require the same controller during reauthentication."""
+    with patch.object(flow, "_get_reauth_entry", return_value=entry):
+        assert (await flow.async_step_reauth({}))["step_id"] == "reauth_confirm"
+        with patch.object(flow, "_async_discover", AsyncMock(return_value=[])):
+            assert (await flow.async_step_reauth_confirm(CREDENTIALS))["errors"] == {
+                "base": "wrong_controller"
+            }
+        with (
+            patch.object(flow, "_async_discover", AsyncMock(return_value=systems)),
+            patch.object(
+                flow, "async_update_reload_and_abort", return_value={"type": "abort"}
+            ) as update,
+        ):
+            await flow.async_step_reauth_confirm(CREDENTIALS)
+        update.assert_called_once_with(entry, data_updates=CREDENTIALS)
+
+
+async def test_discovery_is_read_only(
+    flow: EvohomeConfigFlow, systems: list[tuple[int, SimpleNamespace, SimpleNamespace]]
+) -> None:
+    """Use configuration-only discovery and avoid persistent token writes."""
+    client = MagicMock(locations=[systems[0][1]])
+    client.setup = AsyncMock()
+    with (
+        patch(
+            "homeassistant.components.evohome.config_flow.async_get_clientsession",
+            return_value=MagicMock(),
+        ),
+        patch("homeassistant.components.evohome.config_flow.TokenManager") as manager,
+        patch(
+            "homeassistant.components.evohome.config_flow.evo.EvohomeClient",
+            return_value=client,
+        ),
+    ):
+        assert await flow._async_discover(CREDENTIALS) == systems
+    assert manager.call_args.kwargs["store_key"] is None
+    client.setup.assert_awaited_once_with()
+    assert [call[0] for call in client.method_calls] == ["setup"]
+
+
+async def test_options(hass: HomeAssistant, entry: MockConfigEntry) -> None:
+    """Expose bounded polling and save the selected interval."""
+    flow = EvohomeConfigFlow.async_get_options_flow(entry)
+    assert isinstance(flow, EvohomeOptionsFlow)
+    flow.hass = hass
+    with patch.object(
+        type(flow), "config_entry", new_callable=lambda: property(lambda _: entry)
+    ):
+        result: ConfigFlowResult = await flow.async_step_init()
+    assert result["data_schema"]({"scan_interval": 300}) == {"scan_interval": 300}
+    assert (await flow.async_step_init({"scan_interval": 600}))["data"] == {
+        "scan_interval": 600
+    }

+"""Acceptance of entry-owned runtime, area sensors and token migration."""
+
+import json
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import evohomeasync as evo_v1
+import evohomeasync2 as evo
+import pytest
+
+from homeassistant.components.evohome import async_remove_entry
+from homeassistant.components.evohome.const import DOMAIN, STORAGE_KEY, STORAGE_VER
+from homeassistant.components.evohome.diagnostics import (
+    async_get_config_entry_diagnostics,
+)
+from homeassistant.components.evohome.storage import TokenManager
+from homeassistant.config_entries import ConfigEntryState
+from homeassistant.core import HomeAssistant
+from homeassistant.exceptions import HomeAssistantError
+from homeassistant.helpers import (
+    area_registry as ar,
+    device_registry as dr,
+    entity_registry as er,
+)
+
+from .conftest import get_evo_data, setup_evohome
+from .const import USERNAME
+from .test_storage import TEST_STORAGE_DATA
+
+
+@pytest.mark.parametrize("install", ["default"])
+async def test_import_preserves_custom_id_area_and_sensor_metadata(
+    hass: HomeAssistant,
+    config: dict[str, str],
+    install: str,
+    entity_registry: er.EntityRegistry,
+    area_registry: ar.AreaRegistry,
+    device_registry: dr.DeviceRegistry,
+) -> None:
+    """Adopt a renamed legacy entity and expose measured room temperature."""
+    area = area_registry.async_create("Test study")
+    legacy = entity_registry.async_get_or_create(
+        "climate",
+        DOMAIN,
+        "3432576",
+        suggested_object_id="custom_room_name",
+        original_name="Main Room",
+    )
+    entity_registry.async_update_entity(legacy.entity_id, area_id=area.id)
+    async for _ in setup_evohome(hass, config, install=install):
+        adopted = entity_registry.async_get(legacy.entity_id)
+        assert adopted is not None
+        assert adopted.area_id == area.id
+        assert adopted.has_entity_name
+        assert adopted.original_name == "Heating"
+        assert adopted.config_entry_id is not None
+        sensor_id = entity_registry.async_get_entity_id(
+            "sensor", DOMAIN, "3432576_temperature"
+        )
+        assert sensor_id is not None
+        sensor = hass.states.get(sensor_id)
+        climate = hass.states.get(legacy.entity_id)
+        assert sensor is not None and climate is not None
+        assert sensor.attributes["device_class"] == "temperature"
+        assert sensor.attributes["state_class"] == "measurement"
+        assert sensor.attributes["unit_of_measurement"] == "°C"
+        assert float(sensor.state) == climate.attributes["current_temperature"]
+        assert float(sensor.state) != climate.attributes["temperature"]
+        sensor_entry = entity_registry.async_get(sensor_id)
+        assert sensor_entry is not None and sensor_entry.device_id is not None
+        device = device_registry.async_get(sensor_entry.device_id)
+        assert device is not None and device.area_id == area.id
+        area_registry.async_update(area.id, temperature_entity_id=sensor_id)
+        assert area_registry.async_get_area(area.id).temperature_entity_id == sensor_id

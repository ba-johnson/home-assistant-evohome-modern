diff --git a/homeassistant/components/evohome/device.py b/homeassistant/components/evohome/device.py
new file mode 100644
index 0000000000..e20a221c01
--- /dev/null
+++ b/homeassistant/components/evohome/device.py
@@ -0,0 +1,38 @@
+"""Device registry metadata shared by entities for a controller or zone."""
+
+import evohomeasync2 as evo
+
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers import area_registry as ar, entity_registry as er
+from homeassistant.helpers.device_registry import DeviceInfo
+
+from .const import DOMAIN
+
+
+def device_info(
+    hass: HomeAssistant, device: evo.Zone | evo.HotWater | evo.ControlSystem, kind: str
+) -> DeviceInfo:
+    """Group entities without changing existing platform unique IDs."""
+    device_id = device.id
+    if isinstance(device, evo.Zone) and device.id == device.tcs.id:
+        device_id += "z"
+    name = (
+        device.location.name if isinstance(device, evo.ControlSystem) else device.name
+    )
+    info = DeviceInfo(
+        identifiers={(DOMAIN, f"{kind}_{device_id}")},
+        manufacturer="Honeywell",
+        name=name,
+        model=str(getattr(device, "model", kind)),
+    )
+    # Reuse the room already assigned to the legacy climate entity as a suggestion.
+    # Device registry preserves a user's existing device-area choice.
+    registry = er.async_get(hass)
+    platform = "water_heater" if isinstance(device, evo.HotWater) else "climate"
+    entity_id = registry.async_get_entity_id(platform, DOMAIN, device_id)
+    entity = registry.async_get(entity_id) if entity_id else None
+    if entity and entity.area_id:
+        area = ar.async_get(hass).async_get_area(entity.area_id)
+        if area:
+            info["suggested_area"] = area.name
+    return info

+    entity_registry: er.EntityRegistry,
+) -> None:
+    """Never retain a stale room reading as available after a failed poll."""
+    coordinator = get_evo_data(hass).coordinator
+    entity_id = entity_registry.async_get_entity_id(
+        "sensor", DOMAIN, "3432576_temperature"
+    )
+    assert entity_id is not None
+    with patch.object(
+        coordinator.loc, "get_status", side_effect=evo.EvohomeError("offline")
+    ):
+        await coordinator.async_refresh()
+        await hass.async_block_till_done()
+        assert hass.states.get(entity_id).state == "unavailable"
+    await coordinator.async_refresh()
+    await hass.async_block_till_done()
+    assert hass.states.get(entity_id).state not in ("unavailable", "unknown")
